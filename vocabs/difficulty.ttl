@prefix kquizdifficulty: <http://example.org/kquiz/vocab/difficulty/> .
@prefix kquizdifficultycs: <http://example.org/kquiz/vocab/difficulty> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

# Difficulty Vocabulary (concept scheme)
kquizdifficultycs: a skos:ConceptScheme ;
  schema:dateCreated "2026-08-17"^^xsd:date ;
  schema:dateModified "2026-08-17"^^xsd:date ;
  skos:prefLabel "Question Difficulty Vocabulary"@en ;
  skos:definition "A concept scheme representing the difficulty levels of questions." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizdifficulty:Easy a skos:Concept ;
  skos:prefLabel "Easy"@en ;
  skos:definition "A question that is easy to answer." ;
  skos:inScheme kquizdifficultycs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizdifficulty:Medium a skos:Concept ;
  skos:prefLabel "Medium"@en ;
  skos:definition "A question that is of medium difficulty." ;
  skos:inScheme kquizdifficultycs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizdifficulty:Hard a skos:Concept ;
  skos:prefLabel "Hard"@en ;
  skos:definition "A question that is difficult to answer." ;
  skos:inScheme kquizdifficultycs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .
