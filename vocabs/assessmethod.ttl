@prefix kquizassessmethod: <http://example.org/kquiz/vocab/assessmethod/> .
@prefix kquizassessmethodcs: <http://example.org/kquiz/vocab/assessmethod> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

# Assessment Method Vocabulary (concept scheme)
kquizassessmethodcs: a skos:ConceptScheme ;
  schema:dateCreated "2026-08-17"^^xsd:date ;
  schema:dateModified "2026-08-17"^^xsd:date ;
  skos:prefLabel "Assessment Method Vocabulary"@en ;
  skos:definition "A concept scheme representing the various methods for assessing user responses." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizassessmethod:ExactMatch a skos:Concept ;
  skos:prefLabel "Exact match assessment"@en ;
  skos:definition "An assessment method that requires the user's response to match the correct answer exactly." ;
  skos:inScheme kquizassessmethodcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizassessmethod:PartialMatch a skos:Concept ;
  skos:prefLabel "Partial match assessment"@en ;
  skos:definition "An assessment method that allows for some flexibility in the user's response." ;
  skos:inScheme kquizassessmethodcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizassessmethod:SemanticMatch a skos:Concept ;
  skos:prefLabel "Semantic match assessment"@en ;
  skos:definition "An assessment method that evaluates the semantic meaning of the user's response." ;
  skos:inScheme kquizassessmethodcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .
