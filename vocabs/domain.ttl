@prefix kquizdom: <http://example.org/kquiz/vocab/domain/> .
@prefix kquizdomcs: <http://example.org/kquiz/vocab/domain> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

# Question Domain Vocabulary (concept scheme)
kquizdomcs: a skos:ConceptScheme ;
  schema:dateCreated "2026-08-17"^^xsd:date ;
  schema:dateModified "2026-08-17"^^xsd:date ;
  skos:prefLabel "Question Domain Vocabulary"@en ;
  skos:definition "A concept scheme representing the various domains or subject areas of questions." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquizdom:OWL a skos:Concept ;
  skos:prefLabel "OWL domain question"@en ;
  skos:definition "A question related to the OWL domain." ;
  skos:inScheme kquizdomcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date ;
  dcterms:references <https://www.w3.org/TR/owl2-overview/> .

kquizdom:RDFS a skos:Concept ;
  skos:prefLabel "RDFS domain question"@en ;
  skos:definition "A question related to the RDFS domain." ;
  skos:inScheme kquizdomcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date ;
  dcterms:references <https://www.w3.org/TR/rdf-schema/> .

kquizdom:SPARQL a skos:Concept ;
  skos:prefLabel "SPARQL domain question"@en ;
  skos:definition "A question related to the SPARQL domain." ;
  skos:inScheme kquizdomcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date ;
  dcterms:references <https://www.w3.org/TR/rdf-sparql-query/> .

kquizdom:Turtle a skos:Concept ;
  skos:prefLabel "Turtle domain question"@en ;
  skos:definition "A question related to the Turtle domain." ;
  skos:inScheme kquizdomcs: ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date ;
  dcterms:references <https://www.w3.org/TR/turtle/> .
