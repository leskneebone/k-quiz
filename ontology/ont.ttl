@prefix kquiz: <http://example.org/kquiz#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# K-Quiz ontology metadata
kquiz: a owl:Ontology ;
  rdfs:label "K-Quiz Ontology" ;
  rdfs:comment "An ontology for representing questions in K-Quiz, a knowledge-based quiz system." ;
  schema:dateCreated "2026-08-17"^^xsd:date ;
  schema:dateModified "2026-08-17"^^xsd:date ;
  schema:creator <https://orcid.org/0000-0001-5640-3202> ;
  schema:license <https://creativecommons.org/licenses/by-nc-sa/4.0/> ;
  schema:copyrightHolder <https://orcid.org/0000-0001-5640-3202> ;
  schema:copyrightYear "2026"^^xsd:gYear ;
  schema:copyrightNotice "© 2026 Les Kneebone. Licensed under CC BY-NC-SA 4.0." .

# Classes
kquiz:Question a rdfs:Class ;
  rdfs:label "Question" ;
  rdfs:comment "A class representing a question in a quiz." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

# Properties
kquiz:domain a rdfs:Property ;
  rdfs:label "domain" ;
  rdfs:comment "The domain or subject area of the question." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range skos:Concept ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:questionType a rdfs:Property ;
  rdfs:label "question type" ;
  rdfs:comment "The type of the question." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range skos:Concept ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:responseFormat a rdfs:Property ;
  rdfs:label "response format" ;
  rdfs:comment "The format in which the response to the question is expected, such as multiple choice, true/false, or short answer." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range skos:Concept ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:assessmentMethod a rdfs:Property ;
  rdfs:label "assessment method" ;
  rdfs:comment "The method used to assess the correctness of the response, such as exact match, partial credit, or manual grading." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range skos:Concept ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:difficulty a rdfs:Property ;
  rdfs:label "difficulty" ;
  rdfs:comment "The difficulty level of the question, such as easy, medium, or hard." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range skos:Concept ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:prompt a rdfs:Property ;
  rdfs:label "prompt" ;
  rdfs:comment "The text of the question or prompt presented to the user." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  rdfs:range xsd:string ;
  rdfs:domain kquiz:Question ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:hasOption a rdfs:Property ;
  rdfs:label "has option" ;
  rdfs:comment "The options available for the question, typically used in multiple-choice questions." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

kquiz:correctOption a rdfs:Property ;
  rdfs:label "correct option" ;
  rdfs:comment "The correct option for the question, used to assess the user's response." ;
  rdfs:isDefinedBy <http://example.org/kquiz> ;
  dcterms:created "2026-08-17"^^xsd:date ;
  dcterms:modified "2026-08-17"^^xsd:date .

# Provenance (moved to ontology)
<https://orcid.org/0000-0001-5640-3202> a schema:Person ;
  schema:name "Les Kneebone" ;
  schema:email "les.kneebone@example.com"^^xsd:anyURI .
